includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    # Analyse against the lowest supported PHP version, whatever PHP runs it
    phpVersion: 80300
    paths:
        - src
        - config
        - database
        - tests
    excludePaths:
        - tests/fixtures
    tmpDir: build/phpstan
    ignoreErrors:
        # The package's config file is a config file: env() is expected there.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/mediatheque.php
        # The 1.x defaults read the environment as the 1.x config file did, to
        # compare a 1.x config with them. It only runs on a config that isn't
        # cached: the provider reads a cached config as it is.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: src/Compat/V1Defaults.php
        # The compatibility test eager loads the 1.x relation name `files` on
        # purpose: MediaBuilder loads it as `mediaFiles`.
        -
            identifier: larastan.relationExistence
            path: tests/Feature/Compat/V1ApiTest.php
