{
    "name": "@folklore/mediatheque-dashboard",
    "private": true,
    "description": "The monitoring dashboard of folklore/laravel-mediatheque, built into ../dist",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "tsc --noEmit && vite build",
        "dev": "vite build --watch",
        "test": "vitest run",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@panneau/ui": "5.0.0-alpha.3",
        "react": "19.3.1",
        "react-aria-components": "1.22.1",
        "react-dom": "19.3.1",
        "react-intl": "12.1.5"
    },
    "devDependencies": {
        "@testing-library/react": "^16.3.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "jsdom": "^30.1.2",
        "typescript": "~6.0.3",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    }
}
