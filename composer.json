{
    "name": "folklore/laravel-mediatheque",
    "description": "",
    "keywords": [
        "laravel"
    ],
    "homepage": "http://github.com/Folkloreatelier",
    "license": "MIT",
    "authors": [
        {
            "name": "Folklore",
            "email": "info@atelierfolklore.ca",
            "homepage": "http://atelierfolklore.ca"
        },
        {
            "name": "David Mongeau-Petitpas",
            "email": "dmp@atelierfolklore.ca",
            "homepage": "http://mongo.ca",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^6.3.1|^7.0.1",
        "php-ffmpeg/php-ffmpeg": "^0.17.0|^1.0.0",
        "symfony/http-foundation": "^5.0|^6.0|^7.0|^8.0",
        "symfony/process": "^5.0|^6.0|^7.0|^8.0",
        "ramsey/uuid": "^3.7|^4.0",
        "symfony/mime": "^5.2|^6.0|^7.0|^8.0",
        "contao/imagine-svg": "^1.0",
        "aminyazdanpanah/php-ffmpeg-video-streaming": "^1.2",
        "aws/aws-sdk-php": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "ksubileau/color-thief-php": "^2.0",
        "larastan/larastan": "^2.9|^3.0",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.5.10|^10.5|^11.0|^12.0"
    },
    "suggest": {
        "ext-imagick": "*",
        "ext-gd": "*",
        "league/color-extractor": "0.3.*"
    },
    "autoload": {
        "psr-0": {
            "Folklore\\Mediatheque": "src/"
        },
        "files": [
            "src/Folklore/Mediatheque/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Folklore\\Mediatheque\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Folklore\\Mediatheque\\ServiceProvider"
            ],
            "aliases": {
                "Mediatheque": "Folklore\\Mediatheque\\Facade"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
