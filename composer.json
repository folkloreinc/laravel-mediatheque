{
    "name": "folklore/laravel-mediatheque",
    "description": "Media library for Laravel: ingest, probe, transcode and serve video, audio, images, documents and fonts",
    "keywords": [
        "laravel",
        "media",
        "ingest",
        "video",
        "transcoding",
        "ffmpeg"
    ],
    "homepage": "https://github.com/folkloreinc/laravel-mediatheque",
    "license": "MIT",
    "authors": [
        {
            "name": "Folklore",
            "email": "info@atelierfolklore.ca",
            "homepage": "http://atelierfolklore.ca"
        },
        {
            "name": "David Mongeau-Petitpas",
            "email": "dmp@atelierfolklore.ca",
            "homepage": "http://mongo.ca",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/bus": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "psr/log": "^2.0|^3.0",
        "rhukster/dom-sanitizer": "^1.0.7",
        "symfony/mime": "^7.2|^8.0",
        "symfony/process": "^7.2|^8.0",
        "symfony/uid": "^7.2|^8.0"
    },
    "require-dev": {
        "folklore/laravel-image": "^2.0.0-alpha.2",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "league/flysystem-aws-s3-v3": "^3.25",
        "league/flysystem-memory": "^3.25",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0",
        "rector/rector": "^2.2"
    },
    "suggest": {
        "ext-imagick": "Probes and renders images, documents and fonts",
        "aws/aws-sdk-php": "Required by the mediaconvert transcoder",
        "league/flysystem-aws-s3-v3": "S3-compatible disks",
        "folklore/laravel-eclair": "The eclair transcoder",
        "folklore/laravel-image": "Image renditions on the fly, from media ids",
        "rector/rector": "Runs the rules of rector.php that upgrade 1.x code"
    },
    "conflict": {
        "folklore/laravel-image": "2.0.0-alpha.1"
    },
    "autoload": {
        "psr-4": {
            "Folklore\\Mediatheque\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Folklore\\Mediatheque\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "branch-alias": {
            "dev-v2.x": "2.x-dev"
        },
        "laravel": {
            "providers": [
                "Folklore\\Mediatheque\\ServiceProvider"
            ],
            "aliases": {
                "Mediatheque": "Folklore\\Mediatheque\\Facades\\Mediatheque"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
